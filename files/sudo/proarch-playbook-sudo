#!/usr/bin/bash
set -euo pipefail

# sudo invokes this branch as the requested become user.
if [[ ${1-} == --exec ]]; then
  shift
  exec "$@"
fi

# Preserve the options used by Ansible's sudo plugin and insert the command
# selected by the sudoers Defaults rule in front of the original command.
sudo_options=()
while (( $# > 0 )); do
  case $1 in
    -H|-S|-n|--set-home|--stdin|--non-interactive)
      sudo_options+=("$1")
      shift
      ;;
    -p|-u|--prompt|--user)
      if (( $# < 2 )); then
        printf 'Missing sudo argument for %s.\n' "$1" >&2
        exit 2
      fi
      sudo_options+=("$1" "$2")
      shift 2
      ;;
    --)
      shift
      break
      ;;
    -*)
      printf 'Unsupported sudo option for password mode: %s\n' "$1" >&2
      exit 2
      ;;
    *)
      break
      ;;
  esac
done

if (( $# == 0 )); then
  printf 'A command is required.\n' >&2
  exit 2
fi

exec /usr/bin/sudo "${sudo_options[@]}" -- /usr/local/bin/proarch-playbook-sudo --exec "$@"
